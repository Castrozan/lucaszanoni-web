{
  "name": "lucaszanoni-dynamic-ia-canvas",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "build/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lucaszanoni-dynamic-ia-canvas"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "INFERENCE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_INFERENCE_QUOTA",
        "class_name": "VisitorInferenceQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "visitor-inference-quota-v1",
      "new_sqlite_classes": ["VisitorInferenceQuota"]
    }
  ]
}
