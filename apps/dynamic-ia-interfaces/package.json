{
  "name": "@platform/dynamic-ia-interfaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/worker/entrypoint.ts --bundle --platform=neutral --conditions=workerd,worker,browser --main-fields=module,main --format=esm --target=es2022 --external:cloudflare:* --external:node:* --outfile=dist/worker.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.174",
    "@platform/ai-runtime": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/design-system": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "ai": "^7.0.170",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@platform/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "fast-check": "4.10.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
