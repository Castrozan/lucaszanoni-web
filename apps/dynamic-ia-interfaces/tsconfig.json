{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@/core/*": ["./src/modules/core/*"],
      "@/intent/*": ["./src/modules/intent/*"],
      "@/specification/*": ["./src/modules/specification/*"],
      "@/conversation/*": ["./src/modules/conversation/*"],
      "@/agent/*": ["./src/modules/agent/*"],
      "@/multimodal/*": ["./src/modules/multimodal/*"],
      "@/composition/*": ["./src/modules/composition/*"],
      "@/adaptive/*": ["./src/modules/adaptive/*"]
    }
  },
  "include": ["src"]
}
