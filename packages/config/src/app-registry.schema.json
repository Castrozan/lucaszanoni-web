{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lucaszanoni.com/schemas/app-registry.schema.json",
  "title": "Platform application registry",
  "description": "The single declarative source of truth every consumer derives from: typed loader, Terraform, and the Cloudflare deploy.",
  "type": "array",
  "items": {
    "$ref": "#/definitions/appRegistryEntry"
  },
  "definitions": {
    "appRegistryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mountPath",
        "navigationLabel",
        "description",
        "showInCrossSectionNavigation",
        "status",
        "accessModel",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^(/|/.*/)$"
        },
        "navigationLabel": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "showInCrossSectionNavigation": {
          "type": "boolean"
        },
        "status": {
          "enum": ["active", "retired"]
        },
        "accessModel": {
          "$ref": "#/definitions/accessModel"
        },
        "accessApplicationProvisioning": {
          "$ref": "#/definitions/accessApplicationProvisioning"
        },
        "origin": {
          "$ref": "#/definitions/origin"
        },
        "servingLocation": {
          "$ref": "#/definitions/servingLocation"
        },
        "healthProbePath": {
          "type": "string",
          "pattern": "^/"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["generative-ai", "snapshot-ingestion", "snapshot-data"]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["origin"],
            "properties": {
              "origin": {
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "const": "static-gcs-bucket"
                  }
                },
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "accessModel": {
                "required": ["environment"],
                "properties": {
                  "environment": {
                    "const": "public"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": ["cloudflare-worker"]
                  }
                },
                "required": ["kind"]
              }
            },
            "required": ["origin"]
          },
          "then": {
            "required": ["source"]
          }
        }
      ]
    },
    "servingLocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "path-prefix"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "subdomainLabel"],
          "properties": {
            "kind": {
              "const": "subdomain"
            },
            "subdomainLabel": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            }
          }
        }
      ]
    },
    "accessApplicationProvisioning": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "dedicated"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parentMountPath"],
          "properties": {
            "kind": {
              "const": "inherited-from-parent-path"
            },
            "parentMountPath": {
              "type": "string",
              "pattern": "^/.*/$"
            }
          }
        }
      ]
    },
    "accessModel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment"],
          "properties": {
            "environment": {
              "const": "public"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment", "audience"],
          "properties": {
            "environment": {
              "const": "private"
            },
            "audience": {
              "$ref": "#/definitions/accessAudience"
            }
          }
        }
      ]
    },
    "accessAudience": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "owner"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "audienceKey"],
          "properties": {
            "kind": {
              "const": "shared"
            },
            "audienceKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scriptName"],
          "properties": {
            "kind": {
              "const": "cloudflare-worker"
            },
            "scriptName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "originHost",
            "pathRewrite",
            "forwardedBasePath",
            "trusted"
          ],
          "properties": {
            "kind": {
              "const": "external-https"
            },
            "originHost": {
              "type": "string",
              "minLength": 1
            },
            "pathRewrite": {
              "enum": ["preserve", "strip-mount-path"]
            },
            "forwardedBasePath": {
              "type": "string"
            },
            "trusted": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bucketName", "objectKeyPrefix"],
          "properties": {
            "kind": {
              "const": "static-gcs-bucket"
            },
            "bucketName": {
              "type": "string",
              "minLength": 1
            },
            "objectKeyPrefix": {
              "type": "string"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appPackageName",
        "appDirectoryName",
        "buildProfile",
        "publicBuildEnvironment",
        "publicBuildEnvironmentReferences"
      ],
      "properties": {
        "appPackageName": {
          "type": "string",
          "minLength": 1
        },
        "appDirectoryName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "buildProfile": {
          "enum": ["static-spa", "dynamic-service", "worker-service"]
        },
        "publicBuildEnvironment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(VITE_|NEXT_PUBLIC_)[A-Z0-9_]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "publicBuildEnvironmentReferences": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(VITE_|NEXT_PUBLIC_)[A-Z0-9_]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
